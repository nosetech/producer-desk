# producer-desk配布パッケージのsecrets/実行時設定のサンプル。
# 実データは展開先ルートの .env にコピーして作成する。
# bin/start.sh が起動時にこのファイルを読み込み、環境変数としてexportする。
#
#   cp .env.example .env
#
# 詳細は SETUP.md を参照。

# Slack Incoming WebhookのURL。未設定の場合、判断待ち・レビュー待ち発生時の
# Slack通知処理はスキップされる（起動エラーにはならない）。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# orchestrator APIサーバーの待受ポート（既定: 8787）。dashboardの接続先は
# このポートに自動で追従する。
# ORCHESTRATOR_PORT=8787

# dashboardからorchestratorへの接続先URL（既定: http://127.0.0.1:${ORCHESTRATOR_PORT}）。
# 通常は上のORCHESTRATOR_PORTを変更するだけでよく、これを個別に指定する必要は
# ない。dashboardのみ別ホスト・別ポートのorchestratorに向けたい場合にのみ設定する。
# ORCHESTRATOR_URL=http://127.0.0.1:8787

# Ollama REST APIの接続先（未設定時は http://127.0.0.1:11434）。
# Ollamaを別マシンで稼働させている場合はここに指定する。
# OLLAMA_HOST=http://192.168.1.xx:11434

# dashboardのbindポート（既定: 3000）。
# DASHBOARD_PORT=3000

# 同一LAN内の別端末からアクセスする場合に自機のLAN IPを設定する
# （dashboardをそのLAN IPでbindして起動する）。
# LAN_IP=192.168.1.xx
