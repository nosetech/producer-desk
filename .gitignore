# secrets / 実データ
config/projects.yaml
config/sessions.json
config/usage.db
config/execution_overrides.json
config/litellm_config.yaml
.env
.env.*
!.env.example
!.env.*.example
*.local

# --- litellm_proxy（issue #176、ネイティブ構成のLiteLLM Proxy専用venv） ---
litellm_proxy/.venv/

# ログ（logs/<repo>/ の運用は README 参照）
logs/*
!logs/.gitkeep

# macOS
.DS_Store

# --- dashboard (Next.js) ---
dashboard/node_modules/
dashboard/.next/
dashboard/out/
dashboard/build/
dashboard/coverage/
dashboard/*.tsbuildinfo
dashboard/next-env.d.ts
dashboard/npm-debug.log*
dashboard/yarn-debug.log*
dashboard/yarn-error.log*
dashboard/.pnpm-debug.log*
dashboard/.vercel

# --- orchestrator (Python) ---
orchestrator/__pycache__/
orchestrator/**/__pycache__/
orchestrator/*.egg-info/
orchestrator/.venv/
orchestrator/venv/
orchestrator/.pytest_cache/
orchestrator/build/
orchestrator/dist/

# --- dist/（配布パッケージ用レイアウト、issue #110） ---
# dist/bin/start.sh をリポジトリチェックアウト内で動作確認した際に生成される
# 実データ・実行時生成物（上記と同じ理由で無視する。dist/自体はスラッシュを
# 含まないパスにアンカーされる既存ルールの対象外のため個別に追加している）。
dist/config/projects.yaml
dist/config/sessions.json
dist/config/usage.db
dist/logs/*
!dist/logs/.gitkeep
dist/orchestrator/.venv/
dist/orchestrator/dist/
