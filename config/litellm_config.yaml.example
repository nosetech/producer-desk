# config/litellm_config.yaml のサンプル。
# 実データは config/litellm_config.yaml にコピーして作成する（.gitignore対象、コミットしない）。
# 仕様: docs/basic-design.md 4章「LiteLLM Proxyの利用量計測」、issue #176
#
# LiteLLM ProxyはPostgreSQLを導入しないDBなし運用とする（アーキテクチャ設計書
# 5章）。そのためプロジェクトごとの仮想キー発行機能（/key/generate）は使わず、
# 同一LAN内アクセスのみを前提とするネットワーク境界での保護に委ねる
# （CLAUDE.md「確定済みの設計判断」）。この構成では「どのプロジェクトからの
# リクエストか」をAPIキー単位で区別できないため、代わりにmodel_listのエントリを
# プロジェクトごとに分け、model_info.repoにリポジトリ名を埋め込む。
# `config/projects.yaml`のプロジェクトエントリでexecution_mode: litellm_proxyを
# 選んだ場合、litellm_modelにここで定義したmodel_nameを指定する
# （agent_runner.pyが`claude -p --model <litellm_model>`として渡す）。

model_list:
  # 例1: OpenAIのモデルをproject-aの実行手段として使う場合
  - model_name: project-a-openai-gpt4o
    litellm_params:
      model: openai/gpt-4o
      api_key: os.environ/OPENAI_API_KEY
    model_info:
      repo: nosetech/project-a

  # 例2: ローカルLLM（Ollama）をproject-bの実行手段として使う場合
  #
  # num_ctxは必ず明示指定すること。未指定時はOllama自体のデフォルト値が使われる
  # が、Claude Code CLIの自動コンテキスト圧縮（compaction）時のプロンプトは
  # 会話履歴全体を含むためこれを容易に超過し、「the prompt is longer than the
  # context length currently available to the model」という400エラーでセッション
  # が異常終了する（docs/basic-design.md 4章「compaction時のコンテキスト長超過
  # エラーへの注意」参照）。値はOllamaホストのVRAM/RAM容量に収まる範囲で実機
  # 検証して決めること（大きすぎるとOOMの恐れがある）。
  - model_name: project-b-ollama-qwen
    litellm_params:
      model: ollama/qwen2.5-coder:7b
      api_base: http://127.0.0.1:11434
      num_ctx: 32768
    model_info:
      repo: nosetech/project-b
      #
      # 会話量・ターン数の上限（issue #189、いずれも省略時は無制限）。
      # Claude Code CLI自身のauto-compactionは、`--autocompact`が100k〜1M
      # トークン範囲でしか設定できずnum_ctx程度の小さなモデル容量には間に
      # 合わないため、オーケストレータ側で上限を検知し、超過時は次回ディス
      # パッチからセッションをリセットする（その回の完了処理自体は通常通り
      # 行った上で、リセットする旨のコメントを追加投稿する。docs/basic-design.md
      # 4章参照）。litellm_params.num_ctxと同じ「このモデルがどれだけの会話量を
      # 扱えるか」という関心事のため、プロジェクト単位のconfig/projects.yaml
      # ではなくここ（モデル単位）に定義する。
      #
      # max_session_tokensはnum_ctxより余裕を持って小さい値にする
      # （目安: num_ctxの7〜8割）。
      max_session_tokens: 24000
      # max_session_turnsは、transcriptの読み取り失敗時（Claude Code CLI側の
      # 内部形式変更等）にトークン測定が効かなくなった場合のフォールバック
      # 上限であり、単独でも「max_session_tokensに到達する前に必ず先に効く」
      # ことを保証する安全弁として機能させる。目安は「max_session_tokens ÷
      # その自走タスクで1ターンあたりに消費するトークン数（usage_store.pyの
      # 利用量記録や実機での観測値を元に、平均ではなく最大級のターンを想定
      # する）」より小さい値にする。1ターンあたりの消費量の見積りが難しい・
      # 保守的にしたい場合は、まずは20〜30程度から始めて実際のturn_count・
      # コンテキスト量の推移を見ながら調整する。
      max_session_turns: 20

litellm_settings:
  # リクエスト完了イベントごとに orchestrator/orchestrator/litellm_callback.py の
  # UsageStoreLogger を呼び出し、config/usage.db（usage_records）へ統合記録する。
  # LiteLLM Proxyプロセス自身のPYTHONPATHにorchestratorパッケージが解決できる
  # 必要がある（bin/litellm_proxy_start.sh が起動時にorchestratorパッケージを
  # 同一venvへeditable installしてから起動する）。
  #
  # 同じUsageStoreLoggerがasync_pre_call_hookも実装しており、Ollama系プロバイダ
  # （model: ollama/*・ollama_chat/*）宛の/v1/messagesリクエストから、非対応の
  # thinkingパラメータを事前に除去する（issue #185）。会話が長くなりClaude Code
  # CLIが自動コンテキスト圧縮（compaction）を行う際は必ずthinkingパラメータが
  # 付与されるが、Ollamaのモデルの多くはこれを解釈できず400エラーを返し、
  # compactionが失敗してセッション全体が異常終了する不具合があった。
  # litellm_settings.drop_params: trueではこの問題は解決しない（/v1/messages
  # エンドポイントはdrop_paramsが効くOpenAI形式パラメータ検証経路を通らないため。
  # docs/basic-design.md 4章で実機検証済み）ため、設定しない。
  callbacks: ["orchestrator.litellm_callback.usage_store_logger"]

general_settings:
  # 予算上限のハード制限（budget/max_budget等）はDBなし運用では機能しない
  # （起動時警告のみで素通りする）ため設定しない。可視化のみを目的とする
  # （docs/basic-design.md 4章、要件定義書 3-4）。
  #
  # master_keyも設定しない。認証はネットワーク境界（同一LAN内アクセスのみ）に
  # 委ね、アプリレベルの追加認証は設けないという確定済み設計判断
  # （CLAUDE.md 6-2、basic-design.md 6-2）に、オーケストレータ本体の内部API
  # （8787番ポート）と同様に揃える。
  port: 4000
