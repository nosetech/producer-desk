# config/projects.yaml のサンプル。
# 実データは config/projects.yaml にコピーして作成する（.gitignore対象、コミットしない）。
# 仕様: docs/basic-design.md 2-1（対象リポジトリ一覧の管理）
#
# 開発用インスタンスを運用インスタンスと並行起動する場合は、このファイルとは
# 別に環境変数 PROJECTS_CONFIG_PATH で参照先を切り替える
# （テスト用プロジェクトのみを記載した別ファイルを用意する。README「リリース・
# 日常運用」参照）。運用中の実プロジェクトを開発用インスタンスの対象に含めると、
# 同一worktreeへの同時ディスパッチが起こりうるため避けること。

projects:
  - repo: nosetech/project-a
    worktree_path: /Users/producer/worktrees/project-a
  - repo: nosetech/project-b
    worktree_path: /Users/producer/worktrees/project-b
    # 自走タスク本体の実行手段（issue #148・#174・#176、docs/basic-design.md 4章）。
    # 省略時は claude_code（Claude Code CLI直利用＋サブスクリプション）。
    # litellm_proxy を選ぶ場合は litellm_model（config/litellm_config.yamlの
    # model_listで定義したモデルエイリアス名）の指定が必須。
    # execution_mode: litellm_proxy
    # litellm_model: project-b-ollama-qwen
    #
    # 会話量・ターン数の上限（issue #189、execution_mode: litellm_proxyの場合のみ
    # 指定可）。Claude Code CLI自身のauto-compactionは小コンテキストのローカルLLM
    # には間に合わないため、オーケストレータ側で上限を検知し、超過時は次回
    # ディスパッチからセッションをリセットする（その回の完了処理自体は通常通り
    # 行った上で、リセットする旨のコメントを追加投稿する。docs/basic-design.md
    # 4章参照）。いずれも省略時は無制限。
    # max_session_tokensはconfig/litellm_config.yamlで設定したnum_ctxより余裕を
    # 持って小さい値にする（目安: num_ctxの7〜8割）。
    # max_session_turnsはtranscriptの読み取り失敗時（Claude Code CLI側の内部形式
    # 変更等）にトークン測定が効かなくなった場合のフォールバック上限であり、
    # 単独でも「max_session_tokensに到達する前に必ず先に効く」ことを保証する
    # 安全弁として機能させる。目安は
    # 「max_session_tokens ÷ その自走タスクで1ターンあたりに消費する
    # トークン数（usage_store.pyの利用量記録や実機での観測値を元に、平均では
    # なく最大級のターンを想定する）」より小さい値にする。1ターンあたりの
    # 消費量の見積りが難しい・保守的にしたい場合は、まずは20〜30程度から始めて
    # 実際のturn_count・コンテキスト量の推移（docs/basic-design.md 4章参照）を
    # 見ながら調整する。
    # max_session_tokens: 24000
    # max_session_turns: 20

# logs/orchestrator.log・logs/<repo>/*.log（Agent Runner個別実行ログ）双方の
# 保持日数（未設定時は7）。orchestrator.logはこの日数分をTimedRotatingFileHandler
# が世代管理し、Agent Runner個別実行ログはこの日数（mtime基準）より古いものが
# 実行完了のたびに削除される（docs/basic-design.md 3-2参照、issue #114）。
# log_retention_days: 7
