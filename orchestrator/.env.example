# orchestrator のsecrets/実行時設定のサンプル。
# 実データは orchestrator/.env にコピーして作成する（.gitignore対象、コミットしない）。
# bin/start.sh はこのファイルを起動時に読み込み、環境変数としてexportする。
# `python -m orchestrator.main` を直接起動する場合は、シェル側で
# `set -a; source orchestrator/.env; set +a` 等により自分でexportすること
# （orchestrator自体は .env を自動読み込みしない）。

# Slack Incoming WebhookのURL（docs/basic-design.md 5-1参照）。
# 未設定の場合、判断待ち・レビュー待ち発生時のSlack通知処理はスキップされる
# （起動エラーにはならない）。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# --- 以下は開発用インスタンスを運用インスタンスと並行起動する場合のみ設定する ---
# （README「リリース・日常運用」参照。bin/start.shで起動する運用インスタンスは
# 常に既定値のまま使うため、通常はコメントアウトのままでよい）

# オーケストレータAPIサーバーの待受ポート（既定: 8787）。運用インスタンスと
# ポートが衝突しないよう、開発用インスタンスでは別ポートを指定する。
# ORCHESTRATOR_PORT=8788

# 対象プロジェクト一覧の設定ファイルパス（既定: config/projects.yaml）。
# 運用中の実プロジェクトを開発用インスタンスの対象に含めないよう、
# テスト用プロジェクトのみを記載した別ファイルを指定する。
# PROJECTS_CONFIG_PATH=config/projects.dev.yaml

# Agent Runnerセッションの永続化先ファイルパス（既定: config/sessions.json）。
# 運用インスタンスと同じファイルを共有すると、同一issueへの同時ディスパッチが
# 起こりうるため、開発用インスタンスでは別ファイルを指定する。
# SESSIONS_PATH=config/sessions.dev.json
